  </main>

  <footer>
    <div class="container footer-content">
      <a href="#home" class="logo">J<span>.</span> OCHILO</a>
      <p>© <span id="year">2026</span> Jerry Ochilo. All rights reserved.</p>
      <p>Built with intention. <strong>Designed for growth.</strong></p>
    </div>
  </footer>

  <script>
    document.getElementById("year").textContent =


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0b0b0a">

  <title>Jerry Ochilo | Digital Portfolio</title>
  <meta name="description" content="The personal portfolio of Jerry Ochilo — IT student, aspiring cybersecurity professional, and digital creator.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --background: #0b0b0a;
      --surface: #121210;
      --gold: #c9a96e;
      --ivory: #f3f0e8;
      --muted: #929087;
      --border: rgba(201, 169, 110, 0.22);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--background);
      color: var(--ivory);
      font-family: "DM Sans", sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, a {
      -webkit-tap-highlight-color: transparent;
    }

    .container {
      width: min(1120px, 88%);
      margin: 0 auto;
    }

    /* NAVIGATION */

    header {
      position: relative;
      z-index: 10;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }

    nav {
      min-height: 84px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      font-size: 20px;
      font-weight: 600;
      letter-spacing: 3px;
    }

    .logo span {
      color: var(--gold);
    }

    .nav-link {
      color: var(--muted);
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
      transition: color .3s ease;
    }

    .nav-link:hover {
      color: var(--gold);
    }

    /* HERO */

    .hero {
      min-height: 76vh;
      display: flex;
      align-items: center;
      padding: 95px 0 105px;
      position: relative;
      isolation: isolate;
    }

    .hero::before {
      content: "";
      position: absolute;
      z-index: -1;
      top: 8%;
      right: -15%;
      width: 420px;
      height: 420px;
      background: radial-gradient(
        circle,
        rgba(201,169,110,0.10),
        transparent 68%
      );
      pointer-events: none;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 4px;
      font-size: 11px;
      margin-bottom: 30px;
    }

    .eyebrow::before {
      content: "";
      width: 35px;
      height: 1px;
      background: var(--gold);
    }

    h1 {
      font-family: "Playfair Display", Georgia, serif;
      font-weight: 400;
      font-size: clamp(48px, 9vw, 100px);
      letter-spacing: -3px;
      line-height: 1.08;
      max-width: 850px;
    }

    h1 span {
      color: var(--gold);
      font-style: italic;
    }

    .hero-description {
      max-width: 540px;
      margin-top: 28px;
      color: var(--muted);
      font-size: 15px;
      font-weight: 300;
    }

    .buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 36px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      min-height: 52px;
      padding: 0 24px;
      border: 1px solid var(--border);
      font-size: 12px;
      letter-spacing: 1px;
      transition:
        background .3s ease,
        color .3s ease,
        border-color .3s ease,
        transform .3s ease;
    }

    .btn:hover {
      transform: translateY(-3px);
    }

    .btn-primary {
      background: var(--gold);
      color: #11100d;
      border-color: var(--gold);
    }

    .btn-primary:hover {
      background: var(--ivory);
      border-color: var(--ivory);
    }

    .btn-secondary {
      color: var(--ivory);
    }

    .btn-secondary:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .scroll-note {
      margin-top: 65px;
      color: #77766e;
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    /* ABOUT */

    section {
      padding: 95px 0;
      border-top: 1px solid rgba(255,255,255,0.07);
    }

    .section-label {
      color: var(--gold);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 4px;
      margin-bottom: 18px;
    }

    h2 {
      font-family: "Playfair Display", Georgia, serif;
      font-weight: 400;
      font-size: clamp(35px, 5vw, 56px);
      line-height: 1.2;
      letter-spacing: -1px;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 65px;
      align-items: start;
    }

    .about-copy {
      color: var(--muted);
      font-size: 14px;
      margin-top: 22px;
      max-width: 570px;
    }

    .focus-card {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 30px;
    }

    .focus-card h3 {
      font-family: "Playfair Display", Georgia, serif;
      font-weight: 400;
      font-size: 25px;
      margin-bottom: 18px;
    }

    .focus-card p {
      padding: 13px 0;
      color: var(--muted);
      font-size: 13px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }

    .focus-card p:last-child {
      border-bottom: none;
    }

    .focus-card p span {
      color: var(--gold);
      margin-right: 10px;
    }

    /* CONTACT */

    .contact {
      text-align: center;
      padding: 110px 0;
    }

    .contact h2 {
      max-width: 700px;
      margin: 0 auto;
    }

    .contact-copy {
      color: var(--muted);
      font-size: 14px;
      margin: 20px auto 0;
      max-width: 470px;
    }

    .contact .buttons {
      justify-content: center;
    }

    .social-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      margin-top: 32px;
    }

    .social-links a {
      padding: 10px 16px;
      border: 1px solid rgba(255,255,255,0.1);
      color: var(--muted);
      font-size: 12px;
      transition: all .3s ease;
    }

    .social-links a:hover {
      border-color: var(--gold);
      color: var(--gold);
      transform: translateY(-2px);
    }

    /* FOOTER */

    footer {
      border-top: 1px solid rgba(255,255,255,0.08);
      padding: 27px 0;
    }

    .footer-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    footer p {
      color: var(--muted);
      font-size: 11px;
    }

    footer strong {
      color: var(--gold);
      font-weight: 500;
    }

    /* ANIMATIONS */

    .reveal {
      animation: revealUp .9s ease both;
    }

    .delay-1 {
      animation-delay: .15s;
    }

    .delay-2 {
      animation-delay: .3s;
    }

    @keyframes revealUp {
      from {
        opacity: 0;
        transform: translateY(22px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }

    /* MOBILE */

    @media (max-width: 700px) {
      nav {
        min-height: 72px;
      }

      .hero {
        min-height: auto;
        padding: 90px 0 80px;
      }

      h1 {
        letter-spacing: -1.8px;
      }

      .hero-description {
        font-size: 14px;
      }

      .about-grid {
        grid-template-columns: 1fr;
        gap: 35px;
      }

      section {
        padding: 75px 0;
      }

      .contact {
        padding: 85px 0;
      }

      .btn {
        flex: 1 1 150px;
        padding: 0 15px;
      }

      .footer-content {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="container">
